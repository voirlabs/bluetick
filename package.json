{
  "name": "bluetick",
  "version": "0.1.0",
  "private": true,
  "description": "AI agents for WhatsApp, defined in code. Self-hosted, on the official Cloud API.",
  "license": "MIT",
  "author": "Voir Labs LLC",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @bluetick/web dev",
    "build": "pnpm --filter @bluetick/web build",
    "start": "pnpm --filter @bluetick/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:setup": "pnpm --filter @bluetick/web db:setup"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "4.29.5",
      "source-map-js": "1.2.2",
      "baseline-browser-mapping": "2.11.35"
    }
  }
}
