# Copy to apps/web/.env and fill in. Next.js and the Prisma CLI both read it.

# --- Database ---
# PostgreSQL with the pgvector extension (Neon, Supabase, or `docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent

# --- App ---
# Public base URL. Meta delivers webhooks here, so use a tunnel URL when developing locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Password for the dashboard. There are no user accounts. In production it must be at least
# 12 characters; changing it signs everyone out. Generate: openssl rand -base64 18
ADMIN_PASSWORD=
# Signs the session cookie. Required in production. Generate: openssl rand -hex 32
SESSION_SECRET=
# Optional. Proxies in front of the app that append to X-Forwarded-For (default: 1 on Vercel, else 0).
# TRUSTED_PROXY_HOPS=

# --- WhatsApp Cloud API ---
# Meta app -> Customize use case -> API Setup -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
# Graph API token. Use a System User token in production; temporary ones expire in 24h.
WHATSAPP_ACCESS_TOKEN=
# Meta app -> App settings -> Basic -> App secret. Verifies webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta's webhook setup. Generate: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# Optional. Graph API version (default v26.0).
# WHATSAPP_GRAPH_VERSION=
# Optional. Graph API base URL, for a mock server or proxy (default https://graph.facebook.com).
# WHATSAPP_GRAPH_BASE_URL=
# Optional. WhatsApp Business Account ID (Customize use case -> API Setup, the Messaging account ID).
# Lets the inbox send an approved template once a customer's 24-hour window has closed, and tells
# the WhatsApp page which account to check and subscribe when the token reaches more than one.
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Model ---
# OpenAI key, or the key for the OpenAI-compatible API in OPENAI_BASE_URL.
OPENAI_API_KEY=
# Optional. Any OpenAI-compatible API: Ollama, OpenRouter, LM Studio, a proxy (default OpenAI).
# OPENAI_BASE_URL=
# Optional. Model for replies, unless agent.config.ts sets one; must accept images (default gpt-5.4-mini).
# OPENAI_MODEL=
# Optional. Model for the setup assistant (default gpt-5.4-mini).
# OPENAI_BUILDER_MODEL=
# Optional. Embedding model for the knowledge base; must return 1536 dimensions (default text-embedding-3-small).
# OPENAI_EMBEDDING_MODEL=
# Optional. Transcribes customers' voice notes (default gpt-4o-mini-transcribe).
# OPENAI_TRANSCRIBE_MODEL=

# --- Limits ---
# Optional. Messages one customer may send in 10 minutes and in 24 hours before the agent stops
# answering them and the conversation goes to the inbox (defaults 20 and 150; 0 turns a limit off).
# CUSTOMER_MESSAGES_PER_10_MIN=
# CUSTOMER_MESSAGES_PER_DAY=

# --- Privacy ---
# Optional. Where customers write about their data, shown on /privacy and /data-deletion (the
# pages Meta asks for when you publish the app). Without it, they're told to ask on WhatsApp.
# PRIVACY_CONTACT_EMAIL=

# --- Alerts ---
# Optional. Gets a JSON POST ({ "text": ... }) when a conversation needs a person, or a lead or
# booking request comes in. Works with a Slack incoming webhook, a Discord webhook URL ending in
# /slack, or Zapier, Make and n8n webhooks (to forward to email or SMS).
# ALERT_WEBHOOK_URL=
